@dataclass
class BitStream:
    """
    A mutable container for binary data represented as a sequence of bits.
    
    This class provides efficient storage and manipulation of binary data
    at the bit level. It supports appending individual bits or sequences,
    conversion to/from bytes, and various bit-level operations.
    
    Thread Safety: This class is NOT thread-safe. Use external synchronization
    for concurrent access or use BitStreamView for read-only operations.
    
    Memory Efficiency: Bits are stored as integers (0 or 1) in a list. For
    very large streams (>1MB), consider using bytearray-based implementation.
    
    Example:
        >>> stream = BitStream()
        >>> stream.append_bits([1, 0, 1, 1, 0, 0, 1, 0])
        >>> stream.to_bytes()
        b'\\xb0'
        >>> stream.bit_length
        8
    """
    
    bits: list[int] = field(default_factory=list)
    """Internal storage for bits."""
    
    def __post_init__(self) -> None:
        """Validate initial bits if provided."""
        if self.bits:
            self._validate_bits(self.bits)
    
    @staticmethod
    def _validate_bits(bits: Iterable[int]) -> None:
        """
        Validate that all bits are 0 or 1.
        
        Args:
            bits: Iterable of bit values to validate.
        
        Raises:
            ValueError: If any bit is not 0 or 1.
        """
        for b in bits:
            if b not in (0, 1):
                raise ValueError(
                    f"Invalid bit value: {b}. Expected 0 or 1."
                )
    
    def append_bits(self, bits: Iterable[int]) -> int:
        """
        Append multiple bits to the stream.
        
        This method validates each bit before appending. Invalid bits
        will cause the entire operation to fail (atomic operation).
        
        Args:
            bits: Iterable of integers (must be 0 or 1).
        
        Returns:
            int: Number of bits appended.
        
        Raises:
            ValueError: If any bit is not 0 or 1.
        
        Example:
            >>> stream = BitStream()
            >>> stream.append_bits([1, 0, 1, 0])
            4
        """
        bit_list = list(bits)
        self._validate_bits(bit_list)
        self.bits.extend(bit_list)
        return len(bit_list)
    
    def append_bit(self, bit: int) -> None:
        """
        Append a single bit to the stream.
        
        Args:
            bit: Bit value (0 or 1).
        
        Raises:
            ValueError: If bit is not 0 or 1.
        """
        if bit not in (0, 1):
            raise ValueError(f"Invalid bit value: {bit}. Expected 0 or 1.")
        self.bits.append(bit)
    
    def to_bytes(self, byteorder: str = 'big') -> bytes:
        """
        Convert the bit stream to bytes.
        
        Args:
            byteorder: Byte order for conversion ('big' or 'little').
        
        Returns:
            bytes: The binary data as a bytes object.
        
        Raises:
            ValueError: If the number of bits is not a multiple of 8.
        
        Example:
            >>> stream = BitStream(bits=[1, 0, 1, 0, 1, 0, 1, 0])
            >>> stream.to_bytes()
            b'\\xaa'
        """
        if len(self.bits) % 8 != 0:
            raise ValueError(
                f"BitStream length must be multiple of 8 to convert to bytes, "
                f"got {len(self.bits)} bits"
            )
        
        out = bytearray()
        for i in range(0, len(self.bits), 8):
            byte_bits = self.bits[i:i+8]
            if byteorder == 'big':
                b = 0
                for bit in byte_bits:
                    b = (b << 1) | bit
            else:  # little endian
                b = 0
                for i, bit in enumerate(byte_bits):
                    b |= (bit << i)
            out.append(b)
        
        return bytes(out)
    
    @classmethod
    def from_bytes(
        cls, 
        data: Union[bytes, bytearray, memoryview],
        byteorder: str = 'big'
    ) -> BitStream:
        """
        Create a BitStream from bytes.
        
        Args:
            data: The binary data to convert.
            byteorder: Byte order for conversion ('big' or 'little').
        
        Returns:
            BitStream: A new instance with bits extracted from the bytes.
        
        Example:
            >>> stream = BitStream.from_bytes(b'\\xaa')
            >>> stream.bits
            [1, 0, 1, 0, 1, 0, 1, 0]
        """
        bits = []
        for byte in data:
            if byteorder == 'big':
                for i in reversed(range(8)):
                    bits.append((byte >> i) & 1)
            else:  # little endian
                for i in range(8):
                    bits.append((byte >> i) & 1)
        
        return cls(bits=bits)
    
    @classmethod
    def from_int(
        cls, 
        value: int, 
        bit_length: Optional[int] = None
    ) -> BitStream:
        """
        Create a BitStream from an integer.
        
        Args:
            value: Integer value to convert.
            bit_length: Number of bits to use (default: minimum required).
        
        Returns:
            BitStream: A new instance representing the integer.
        
        Raises:
            ValueError: If value is negative or bit_length is insufficient.
        
        Example:
            >>> stream = BitStream.from_int(42, bit_length=8)
            >>> stream.bits
            [0, 0, 1, 0, 1, 0, 1, 0]
        """
        if value < 0:
            raise ValueError(f"Value must be non-negative, got {value}")
        
        if bit_length is None:
            bit_length = max(1, value.bit_length())
        elif value >= (1 << bit_length):
            raise ValueError(
                f"Value {value} requires more than {bit_length} bits"
            )
        
        bits = []
        for i in reversed(range(bit_length)):
            bits.append((value >> i) & 1)
        
        return cls(bits=bits)
    
    def to_int(self) -> int:
        """
        Convert the bit stream to an integer.
        
        Returns:
            int: The integer representation of the bits.
        
        Example:
            >>> stream = BitStream(bits=[0, 0, 1, 0, 1, 0, 1, 0])
            >>> stream.to_int()
            42
        """
        value = 0
        for bit in self.bits:
            value = (value << 1) | bit
        return value
    
    @property
    def bit_length(self) -> int:
        """Return the number of bits in the stream."""
        return len(self.bits)
    
    @property
    def byte_length(self) -> int:
        """Return the number of complete bytes in the stream."""
        return len(self.bits) // 8
    
    def __len__(self) -> int:
        """Return the number of bits in the stream."""
        return len(self.bits)
    
    def __iter__(self) -> Iterator[int]:
        """Iterate over bits in the stream."""
        return iter(self.bits)
    
    def __getitem__(self, index: Union[int, slice]) -> Union[int, list[int]]:
        """
        Get bit(s) at index or slice.
        
        Args:
            index: Integer index or slice object.
        
        Returns:
            Single bit (int) or list of bits for slice.
        """
        return self.bits[index]
    
    def __repr__(self) -> str:
        """Return string representation of the BitStream."""
        return f"BitStream(bits={self.bits!r})"
    
    def __eq__(self, other: object) -> bool:
        """Check equality with another BitStream."""
        if not isinstance(other, BitStream):
            return NotImplemented
        return self.bits == other.bits
    
    def clear(self) -> None:
        """Remove all bits from the stream."""
        self.bits.clear()
    
    def copy(self) -> BitStream:
        """Create a shallow copy of the BitStream."""
        return BitStream(bits=self.bits.copy())
