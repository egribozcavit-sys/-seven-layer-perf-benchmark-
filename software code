    Physical layer (Layer 1) implementation for network simulation.
    
    This class simulates bit-level transmission over a physical medium
    with configurable characteristics including bitrate, latency, jitter,
    and bit error rate (BER).
    
    Features:
        - Configurable transmission parameters
        - Realistic latency and jitter simulation
        - Bit error injection based on BER
        - Comprehensive metrics collection
        - Deterministic simulation with seed support
    
    Thread Safety: This class is NOT thread-safe. Use external synchronization
    (e.g., threading.Lock) for concurrent access.
    
    Example:
        >>> from network_stack.layer1_physical import PhysicalLayer, PhysicalConfig
        >>> config = PhysicalConfig(
        ...     bitrate=1_000_000,
        ...     latency_ms=5.0,
        ...     jitter_ms=1.0,
        ...     error_rate=0.001
        ... )
        >>> layer = PhysicalLayer(config)
        >>> bits = [1, 0, 1, 1, 0, 0, 1, 0]
        >>> stats = layer.send_bits(bits)
        >>> print(f"Sent {stats.bits_sent} bits with {stats.errors_detected} errors")
    """
    
    def __init__(
        self,
        config: PhysicalConfig,
        metrics: Optional[Metrics] = None,
        global_config: Optional[Config] = None,
        rng_seed: Optional[int] = None,
        name: str = "PhysicalLayer",
    ) -> None:
        """
        Initialize the PhysicalLayer.
        
        Args:
            config: Physical layer configuration parameters.
            metrics: Optional metrics collector for monitoring.
            global_config: Optional global configuration override.
            rng_seed: Random seed for reproducible error simulation.
            name: Layer instance name for logging and identification.
        
        Raises:
            ValueError: If configuration parameters are invalid.
        """
        self._config = config
        self._metrics = metrics or Metrics(layer_name=name)
        self._global_config = global_config or Config()
        self._rng = random.Random(rng_seed)
        self._name = name
        
        logger.info(
            f"{self._name} initialized with bitrate={config.bitrate} bps, "
            f"latency={config.latency_ms}ms, error_rate={config.error_rate}"
        )
    
    def send_bits(
        self, 
        bits: Iterable[int],
        timeout_ms: Optional[float] = None
    ) -> TransmissionStats:
        """
        Transmit bits through the physical medium.
        
        This method simulates:
        1. Transmission time based on configured bitrate
        2. Propagation latency and random jitter
        3. Bit errors based on configured bit error rate (BER)
        
        Args:
            bits: Iterable of bits (0 or 1) to transmit.
            timeout_ms: Optional timeout in milliseconds.
        
        Returns:
            TransmissionStats: Statistics about the transmission.
        
        Raises:
            ValueError: If any bit is not 0 or 1.
            TimeoutError: If transmission exceeds timeout_ms.
        
        Example:
            >>> layer = PhysicalLayer(PhysicalConfig(bitrate=1_000_000, latency_ms=5.0))
            >>> stats = layer.send_bits([1, 0, 1, 1, 0, 0, 1, 0])
            >>> assert stats.result == TransmissionResult.SUCCESS
        """
        start = time.perf_counter()
        bit_list = list(bits)
        
        # Validate input
        if not bit_list:
            logger.debug(f"{self._name}: Empty transmission, returning immediately")
            return TransmissionStats(
                bits_sent=0,
                bits_received=0,
                errors_detected=0,
                duration_ms=0.0,
                result=TransmissionResult.SUCCESS
            )
        
        # Validate bits
        invalid_bits = {b for b in bit_list if b not in (0, 1)}
        if invalid_bits:
            raise ValueError(
                f"Invalid bit values detected: {invalid_bits}. "
                f"Expected only 0 or 1."
            )
        
        num_bits = len(bit_list)
        duration_sec = num_bits / self._config.bitrate
        
        # Simulate latency + jitter
        jitter = self._calculate_jitter(bit_list)
        total_delay = duration_sec + (self._config.latency_ms / 1000.0) + jitter
        
        # Check timeout
        if timeout_ms is not None:
            expected_duration_ms = total_delay * 1000
            if expected_duration_ms > timeout_ms:
                raise TimeoutError(
                    f"Transmission would exceed timeout: "
                    f"{expected_duration_ms:.2f}ms > {timeout_ms}ms"
                )
        
        time.sleep(total_delay)
        
        # Simulate bit errors
        errors_detected = 0
        if self._config.error_rate > 0:
            transmitted_bits, errors_detected = self._apply_bit_errors(bit_list)
        else:
            transmitted_bits = bit_list
        
        end = time.perf_counter()
        duration_ms = (end - start) * 1000
        
        # Determine result
        if errors_detected == 0:
            result = TransmissionResult.SUCCESS
        elif errors_detected < num_bits:
            result = TransmissionResult.PARTIAL
        else:
            result = TransmissionResult.FAILED
        
        self._metrics.record_operation(
            num_bytes=num_bits // 8,
            start=start,
            end=end,
            layer="Physical"
        )
        
        logger.debug(
            f"{self._name}: Transmitted {num_bits} bits in {duration_ms:.2f}ms "
            f"with {errors_detected} errors ({result.name})"
        )
        
        return TransmissionStats(
            bits_sent=num_bits,
            bits_received=num_bits - errors_detected,
            errors_detected=errors_detected,
            duration_ms=duration_ms,
            result=result
        )
    
    def receive_bits(
        self, 
        num_bits: int,
        timeout_ms: Optional[float] = None
    ) -> Sequence[int]:
