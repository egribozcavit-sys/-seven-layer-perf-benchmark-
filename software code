    def receive_bitstream(
        self, 
        num_bits: int,
        timeout_ms: Optional[float] = None
    ) -> BitStream:
        """
        Receive bits into a BitStream.
        
        Args:
            num_bits: Number of bits to receive.
            timeout_ms: Optional timeout in milliseconds.
        
        Returns:
            BitStream: Received bits as a BitStream.
        """
        bits = self.receive_bits(num_bits, timeout_ms=timeout_ms)
        return BitStream(bits=list(bits))
    
    def _calculate_jitter(self, bits: Sequence[int]) -> float:
        """
        Calculate jitter based on bit pattern and configuration.
        
        Args:
            bits: Sequence of bits to analyze.
        
        Returns:
            float: Jitter value in seconds.
        """
        if self._config.jitter_ms == 0:
            return 0.0
        
        # Use first 8 bits for deterministic jitter calculation
        sample = bits[:8] if len(bits) >= 8 else bits + [0] * (8 - len(bits))
        pattern_hash = hash(tuple(sample)) % 100
        jitter_factor = pattern_hash / 100.0
        return (self._config.jitter_ms / 1000.0) * jitter_factor
    
    def _apply_bit_errors(
        self, 
        bits: Sequence[int]
    ) -> Tuple[list[int], int]:
        """
        Apply random bit errors based on configured error rate.
        
        Args:
            bits: Original bit sequence.
        
        Returns:
            Tuple of (corrupted_bits, error_count).
        """
        errors = 0
        corrupted = []
        
        for bit in bits:
            if self._rng.random() < self._config.error_rate:
                corrupted.append(bit ^ 1)
                errors += 1
            else:
                corrupted.append(bit)
        
        return corrupted, errors
    
