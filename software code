    def metrics(self) -> Metrics:
        """Return the metrics collector instance."""
        return self._metrics
    
    @property
    def name(self) -> str:
        """Return the layer instance name."""
        return self._name
    
    def __repr__(self) -> str:
        """Return string representation of the PhysicalLayer."""
        return (
