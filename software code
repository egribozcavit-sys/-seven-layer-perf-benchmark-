        # Simulate bit errors
        if self._config.error_rate > 0:
            import random
            bit_list = [
                b ^ 1 if random.random() < self._config.error_rate else b
                for b in bit_list
            ]

        end = time.perf_counter()
        self._metrics.record_operation(num_bytes=num_bits // 8, start=start, end=end)
        return num_bits

