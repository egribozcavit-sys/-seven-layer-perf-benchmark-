class TransactionStatus(Enum):
    PENDING = "pending"
    PROCESSING = "processing"
    COMPLETED = "completed"
    FAILED = "failed"
    REJECTED = "rejected"

@dataclass
class Transaction:
    id: str
    user_id: str
    amount: float
    currency: str
    status: TransactionStatus
    timestamp: datetime
    latency: float = 0.0
    description: Optional[str] = None
    metadata: Dict = field(default_factory=dict)
    
    def __post_init__(self):
        if not self.id:
            self.id = str(uuid.uuid4())
        if not self.timestamp:
            self.timestamp = datetime.utcnow()

class LockFreeTransactionEngine:
    def __init__(self, max_queue_size: int = 1_000_000):
        self.queue = asyncio.Queue(maxsize=max_queue_size)
        self.processed = []
        self.tps_counter = 0
        self.error_counter = 0
        self.start_time = datetime.utcnow()
        self._running = False
        self._workers = []
        self.latencies = []
        self.batch_sizes = []
        
    async def start(self, num_workers: int = 10):
        self._running = True
        for i in range(num_workers):
            worker = asyncio.create_task(self._worker(i))
            self._workers.append(worker)
        print(f"Engine started with {num_workers} workers")
    
    async def stop(self):
        self._running = False
        for worker in self._workers:
            worker.cancel()
        await asyncio.gather(*self._workers, return_exceptions=True)
        print("Engine stopped")
    
    async def submit(self, transaction: Transaction) -> str:
        await self.queue.put(transaction)
        return transaction.id
    
    async def _worker(self, worker_id: int):
        while self._running:
            try:
                batch = []
                while not self.queue.empty() and len(batch) < 1000:
                    try:
                        tx = self.queue.get_nowait()
                        batch.append(tx)
                    except asyncio.QueueEmpty:
                        break
                
                if batch:
                    results = await self._process_batch(batch, worker_id)
                    self.processed.extend(results)
                    self.tps_counter += len(results)
                    self.batch_sizes.append(len(batch))
                
                await asyncio.sleep(0)
                
            except asyncio.CancelledError:
                break
            except Exception as e:
                self.error_counter += 1
    
    async def _process_batch(self, batch: List[Transaction], worker_id: int) -> List[Transaction]:
        async def process_single(tx: Transaction) -> Transaction:
            start = time.perf_counter()
            await self._validate_transaction(tx)
            await self._apply_business_rules(tx)
            tx.status = TransactionStatus.COMPLETED
            tx.latency = (time.perf_counter() - start) * 1000
            self.latencies.append(tx.latency)
            return tx
        
        results = await asyncio.gather(*[process_single(tx) for tx in batch])
        return list(results)
    
    async def _validate_transaction(self, tx: Transaction):
        if tx.amount <= 0:
            raise ValueError("Amount must be positive")
        if len(tx.currency) != 3:
            raise ValueError("Invalid currency code")
    
    async def _apply_business_rules(self, tx: Transaction):
        pass
    
    def get_tps(self) -> float:
        elapsed = (datetime.utcnow() - self.start_time).total_seconds()
        return self.tps_counter / elapsed if elapsed > 0 else 0
    
    def get_avg_latency(self) -> float:
        return sum(self.latencies) / len(self.latencies) if self.latencies else 0.0
    
    def get_p95_latency(self) -> float:
        if not self.latencies:
            return 0.0
        sorted_latencies = sorted(self.latencies)
        p95_index = int(len(sorted_latencies) * 0.95)
        return sorted_latencies[p95_index]
    
    def get_p99_latency(self) -> float:
        if not self.latencies:
            return 0.0
        sorted_latencies = sorted(self.latencies)
        p99_index = int(len(sorted_latencies) * 0.99)
        return sorted_latencies[p99_index]
    
    def get_stats(self) -> Dict:
        return {
            "tps": self.get_tps(),
            "total_processed": self.tps_counter,
            "total_errors": self.error_counter,
            "avg_latency_ms": self.get_avg_latency(),
            "p95_latency_ms": self.get_p95_latency(),
            "p99_latency_ms": self.get_p99_latency(),
            "queue_size": self.queue.qsize(),
            "avg_batch_size": sum(self.batch_sizes) / len(self.batch_sizes) if self.batch_sizes else 0
        }

from fastapi import FastAPI, Depends, HTTPException, status
from fastapi.middleware.cors import CORSMiddleware
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials
from contextlib import asynccontextmanager
import jwt

security = HTTPBearer()
engine: Optional[LockFreeTransactionEngine] = None

@asynccontextmanager
async def lifespan(app: FastAPI):
    global engine
    print("Starting A.S.A.S Pay API...")
    engine = LockFreeTransactionEngine()
    await engine.start(num_workers=10)
    yield
    print("Stopping A.S.A.S Pay API...")
    await engine.stop()

app = FastAPI(
    title="A.S.A.S Pay API",
    description="High-performance payment infrastructure API",
    version="1.0.0",
    lifespan=lifespan
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

async def get_current_user(credentials: HTTPAuthorizationCredentials = Depends(security)):
    try:
        token = credentials.credentials
        payload = jwt.decode(token, os.getenv("JWT_SECRET", "SECRET_KEY"), algorithms=["HS256"])
        user_id = payload.get("sub")
        if user_id is None:
            raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Invalid token")
        return {"user_id": user_id}
    except jwt.PyJWTError:
        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Invalid token")

