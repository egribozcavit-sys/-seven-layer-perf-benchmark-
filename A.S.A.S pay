class SettlementService:
    def __init__(self):
        self.settled_count = 0
    
    async def net_transactions(self, transactions: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        from collections import defaultdict
        netted = defaultdict(float)
        for tx in transactions:
            key = (tx["user_id"], tx["currency"])
            netted[key] += tx["amount"]
        
        return [
            {
                "id": str(uuid.uuid4()),
                "user_id": key[0],
                "amount": amount,
                "currency": key[1],
                "status": "netted",
                "timestamp": datetime.utcnow()
            }
            for key, amount in netted.items()
        ]

from cryptography.hazmat.primitives.ciphers.aead import AESGCM
import hashlib

class AES256GCM:
    def __init__(self, key: bytes = None):
        self.key = key if key else AESGCM.generate_key(bit_length=256)
    
    def encrypt(self, plaintext: bytes, associated_data: bytes = None) -> tuple:
        aesgcm = AESGCM(self.key)
        nonce = os.urandom(12)
        ciphertext = aesgcm.encrypt(nonce, plaintext, associated_data)
        return (nonce, ciphertext)
    
    def decrypt(self, nonce: bytes, ciphertext: bytes, associated_data: bytes = None) -> bytes:
        aesgcm = AESGCM(self.key)
        return aesgcm.decrypt(nonce, ciphertext, associated_data)

class AuditLogger:
    def __init__(self, log_dir: str = "logs/audit"):
        from pathlib import Path
        self.log_dir = Path(log_dir)
        self.log_dir.mkdir(parents=True, exist_ok=True)
        self.current_file = self._get_log_file()
        self.buffer = []
    
    def _get_log_file(self):
        from pathlib import Path
        date_str = datetime.utcnow().strftime("%Y-%m-%d")
        return self.log_dir / f"audit_{date_str}.log"
    
    def log(self, event: Dict[str, Any]):
        event["timestamp"] = datetime.utcnow().isoformat() + "Z"
        event["immutable"] = True
        self.buffer.append(event)
        if len(self.buffer) >= 100:
            self._flush()
    
    def _flush(self):
        with open(self.current_file, 'a') as f:
            for entry in self.buffer:
                f.write(json.dumps(entry) + '\n')
        self.buffer = []

async def run_stress_test(num_transactions: int = 1_000_000):
    print(f"Starting stress test with {num_transactions:,} transactions...")
    
    test_engine = LockFreeTransactionEngine()
    await test_engine.start(num_workers=10)
    
    start_time = time.perf_counter()
    
    users = [f"user_{uuid.uuid4()}" for _ in range(1000)]
    currencies = ["USD", "EUR", "GBP", "TRY"]
    
    for i in range(num_transactions):
        tx = Transaction(
            id=str(uuid.uuid4()),
            user_id=users[i % len(users)],
            amount=100.0,
            currency=currencies[i % len(currencies)],
            status=TransactionStatus.PENDING,
            timestamp=datetime.utcnow()
        )
        await test_engine.submit(tx)
        
        if (i + 1) % 100_000 == 0:
            elapsed = time.perf_counter() - start_time
            tps = (i + 1) / elapsed
            print(f"  Progress: {i + 1:,}/{num_transactions:,} ({tps:,.0f} TPS)")
    
    await asyncio.sleep(5)
    
    end_time = time.perf_counter()
    total_time = end_time - start_time
    
    stats = test_engine.get_stats()
    
    print("")
    print("=" * 60)
    print("STRESS TEST RESULTS")
    print("=" * 60)
    print(f"Total Transactions: {num_transactions:,}")
    print(f"Total Time: {total_time:.2f} seconds")
    print(f"Throughput: {num_transactions / total_time:,.0f} TPS")
    print(f"Engine TPS: {stats['tps']:,.0f}")
    print(f"Avg Latency: {stats['avg_latency_ms']:.2f} ms")
    print(f"P95 Latency: {stats['p95_latency_ms']:.2f} ms")
    print(f"P99 Latency: {stats['p99_latency_ms']:.2f} ms")
    print(f"Total Processed: {stats['total_processed']:,}")
    print(f"Total Errors: {stats['total_errors']:,}")
    print("=" * 60)
    
    await test_engine.stop()

