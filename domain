import logging

logger = logging.getLogger(__name__)


class JWTService:
    def __init__(self, secret_key: str, algorithm: str = "HS256", expiration_minutes: int = 60):
        self.secret_key = secret_key
        self.algorithm = algorithm
        self.expiration_minutes = expiration_minutes

    def create_access_token(self, data: dict, expires_delta: Optional[timedelta] = None) -> str:
        to_encode = data.copy()
        expire = datetime.utcnow() + (expires_delta or timedelta(minutes=self.expiration_minutes))
        to_encode.update({"exp": expire})
        
        try:
            encoded_jwt = jwt.encode(to_encode, self.secret_key, algorithm=self.algorithm)
            logger.info(f"Access token created for: {data.get('sub')}")
            return encoded_jwt
        except Exception as e:
            logger.error(f"JWT encode error: {e}")
            raise Exception("Failed to create access token")

    def decode_access_token(self, token: str) -> dict:
        try:
            payload = jwt.decode(token, self.secret_key, algorithms=[self.algorithm])
            logger.info(f"Access token decoded for: {payload.get('sub')}")
            return payload
        except JWTError as e:
            logger.error(f"JWT decode error: {e}")
            raise Exception("Invalid or expired token")

    def verify_token(self, token: str) -> bool:
        try:
            self.decode_access_token(token)
            return True
        except Exception:
            return False
