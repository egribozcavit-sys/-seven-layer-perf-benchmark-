@dataclass
class ValidationError:
    field: str
    message: str


class PaymentValidator:
    VALID_CURRENCIES = {"USD", "EUR", "TRY", "GBP"}
    MAX_AMOUNT = 1_000_000.0
    MIN_AMOUNT = 0.01

    @classmethod
    def validate_amount(cls, amount: float) -> List[ValidationError]:
        errors = []
        if amount < cls.MIN_AMOUNT:
            errors.append(ValidationError("amount", f"Amount must be at least {cls.MIN_AMOUNT}"))
        if amount > cls.MAX_AMOUNT:
            errors.append(ValidationError("amount", f"Amount cannot exceed {cls.MAX_AMOUNT}"))
        return errors

    @classmethod
    def validate_currency(cls, currency: str) -> List[ValidationError]:
        errors = []
        if not currency or currency.upper() not in cls.VALID_CURRENCIES:
            errors.append(ValidationError("currency", f"Currency must be one of {cls.VALID_CURRENCIES}"))
        return errors

    @classmethod
    def validate_idempotency_key(cls, key: Optional[str]) -> List[ValidationError]:
        errors = []
        if key and len(key) > 100:
            errors.append(ValidationError("idempotency_key", "Idempotency key must be less than 100 characters"))
        return errors

    @classmethod
    def validate_all(cls, amount: float, currency: str, idempotency_key: Optional[str] = None) -> List[ValidationError]:
        errors = []
        errors.extend(cls.validate_amount(amount))
        errors.extend(cls.validate_currency(currency))
        errors.extend(cls.validate_idempotency_key(idempotency_key))
        return errors
