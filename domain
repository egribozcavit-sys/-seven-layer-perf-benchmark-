@dataclass
class CreatePaymentCommand:
    amount: float
    currency: str
    idempotency_key: Optional[str] = None
    customer_id: Optional[str] = None
    description: Optional[str] = None
    metadata: Optional[dict] = None


class CreatePaymentHandler:
    def __init__(self, repository: PaymentRepositoryProtocol):
        self.repository = repository

    async def execute(self, command: CreatePaymentCommand) -> Payment:
        if command.idempotency_key:
            existing = await self.repository.get_by_idempotency_key(command.idempotency_key)
            if existing:
                logger.info(f"Idempotent payment found: {existing.id}")
                return existing

        payment = Payment(
            amount=command.amount,
            currency=command.currency,
            idempotency_key=command.idempotency_key,
            customer_id=command.customer_id,
            description=command.description,
            metadata=command.metadata or {},
        )

        payment.mark_as_processing()
        created = await self.repository.create(payment)

        event = PaymentCreatedEvent(
            payment_id=created.id,
            transaction_id=created.transaction_id,
            amount=created.amount,
            currency=created.currency,
            customer_id=created.customer_id,
            timestamp=created.created_at,
        )
        logger.info(f"Payment created event: {event}")

        return created
