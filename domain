class AuthMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        if request.url.path in ["/health", "/", "/docs", "/openapi.json"]:
            return await call_next(request)
        
        auth_header = request.headers.get("Authorization")
        if not auth_header or not auth_header.startswith("Bearer "):
            return JSONResponse(status_code=status.HTTP_401_UNAUTHORIZED, content={"detail": "Missing or invalid authorization header"})
        
        token = auth_header.split(" ")[1]
        jwt_service = JWTService(secret_key=Config.JWT_SECRET_KEY, algorithm=Config.JWT_ALGORITHM, expiration_minutes=Config.JWT_EXPIRATION_MINUTES)
        
        if not jwt_service.verify_token(token):
            return JSONResponse(status_code=status.HTTP_401_UNAUTHORIZED, content={"detail": "Invalid or expired token"})
        
        try:
            payload = jwt_service.decode_access_token(token)
            request.state.user_id = payload.get("sub")
            request.state.user_email = payload.get("email")
        except Exception:
            return JSONResponse(status_code=status.HTTP_401_UNAUTHORIZED, content={"detail": "Token validation failed"})
        
        return await call_next(request)
