@router.post("/", response_model=PaymentResponse, status_code=status.HTTP_201_CREATED)
async def create_payment(request: PaymentCreateRequest, repository: PaymentRepositoryImpl = Depends(get_repository)):
    errors = PaymentValidator.validate_all(amount=request.amount, currency=request.currency, idempotency_key=request.idempotency_key)
    if errors:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=[{"field": e.field, "message": e.message} for e in errors])
    
    command = CreatePaymentCommand(amount=request.amount, currency=request.currency, idempotency_key=request.idempotency_key, customer_id=request.customer_id, description=request.description, metadata=request.metadata)
    handler = CreatePaymentHandler(repository)
    payment = await handler.execute(command)
    
