class PaymentRepositoryImpl(PaymentRepositoryProtocol):
    def __init__(self, session: AsyncSession):
        self.session = session

    async def create(self, payment: Payment) -> Payment:
        payment_model = PaymentModel(
            id=payment.id,
            transaction_id=payment.transaction_id,
            amount=payment.amount,
            currency=payment.currency,
            status=PaymentStatusEnum(payment.status.value),
            idempotency_key=payment.idempotency_key,
            customer_id=payment.customer_id,
            description=payment.description,
            metadata=payment.metadata,
            created_at=payment.created_at,
            updated_at=payment.updated_at,
            completed_at=payment.completed_at,
        )
        self.session.add(payment_model)
        await self.session.commit()
        await self.session.refresh(payment_model)
        logger.info(f"Payment created in database: {payment.id}")
        return payment

    async def get_by_id(self, payment_id: str) -> Optional[Payment]:
        result = await self.session.execute(select(PaymentModel).where(PaymentModel.id == payment_id))
        payment_model = result.scalar_one_or_none()
        if not payment_model:
            return None
        return self._to_entity(payment_model)

    async def get_by_idempotency_key(self, key: str) -> Optional[Payment]:
        result = await self.session.execute(select(PaymentModel).where(PaymentModel.idempotency_key == key))
        payment_model = result.scalar_one_or_none()
        if not payment_model:
            return None
        return self._to_entity(payment_model)

    async def update(self, payment: Payment) -> Payment:
        result = await self.session.execute(select(PaymentModel).where(PaymentModel.id == payment.id))
        payment_model = result.scalar_one_or_none()
        if not payment_model:
            raise ValueError(f"Payment not found: {payment.id}")
        payment_model.status = PaymentStatusEnum(payment.status.value)
        payment_model.amount = payment.amount
        payment_model.currency = payment.currency
        payment_model.updated_at = payment.updated_at
        payment_model.completed_at = payment.completed_at
        await self.session.commit()
        await self.session.refresh(payment_model)
        logger.info(f"Payment updated in database: {payment.id}")
        return payment

    async def delete(self, payment_id: str) -> bool:
        result = await self.session.execute(select(PaymentModel).where(PaymentModel.id == payment_id))
        payment_model = result.scalar_one_or_none()
        if not payment_model:
            return False
        await self.session.delete(payment_model)
        await self.session.commit()
        logger.info(f"Payment deleted from database: {payment_id}")
        return True

    def _to_entity(self, model: PaymentModel) -> Payment:
        return Payment(
            id=model.id,
            transaction_id=model.transaction_id,
            amount=model.amount,
            currency=model.currency,
            status=PaymentStatus(model.status.value),
            idempotency_key=model.idempotency_key,
            customer_id=model.customer_id,
            description=model.description,
            metadata=model.metadata or {},
            created_at=model.created_at,
            updated_at=model.updated_at,
            completed_at=model.completed_at,
        )
